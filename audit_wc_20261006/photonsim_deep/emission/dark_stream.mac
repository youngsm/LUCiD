# PhotonSim macro (Monoenergetic)
# Configuration: dark
# Config Number: -00001
# Material: water
# Particles: 1

# Set output filename before initialization
/output/filename /sdf/group/neutrino/youngsam/sim/lucid-data/LUCID/audit_wc_20261006/photonsim_deep/emission/dark_stream.root

/run/initialize

/random/setSeeds 314159 271828

# ENABLE individual photon storage for event-by-event analysis
/photon/storeIndividual true
/photon/storeProcessName true
/photon/streamPhotonsChunked true

# Decay processes ENABLED (for data production)

# Clear any existing primaries and set up new ones
/gun/clearPrimaries
/gun/addPrimary e- 0.01 MeV

# Fixed +Z direction (SIREN-input lookup-table mode)
/gun/position 0 0 0 m
/gun/direction 0 0 1

# Run 2 events
/run/beamOn 2
